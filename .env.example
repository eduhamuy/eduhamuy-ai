# Azure Blob Storage account name (without the blob.core.windows.net suffix)
AZURE_STORAGE_ACCOUNT=

# Temporary SAS used by the notebook or a local indexing run
AZURE_STORAGE_SAS=

# Private containers used by the MVP
AZURE_SOURCE_CONTAINER=
# Read-only SAS scoped to AZURE_SOURCE_CONTAINER. It is used only by the
# optional public PDF-preview endpoint; never expose it to the browser.
AZURE_SOURCE_SAS=
AZURE_EVALUATION_CONTAINER=
AZURE_ARTIFACT_CONTAINER=

# Immutable build identifier when running indexer/build_index.py locally
BUILD_VERSION=

# Optional local API port
PORT=
